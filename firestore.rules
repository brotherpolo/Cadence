rules_version = '2';

// Cadence + Formwright — Cloud Firestore security rules (Cadence version 22)
//
// Both apps share this project (tasks-2ae9d). These rules, the Storage rules and the
// indexes deploy from this folder only. Formwright's repo deploys its web pages only.
//
// Cadence data, written by firebase-sync.js:
//   tasks/{taskId}               every task. members = [ownerId] or [ownerId, assigneeId]
//   users/{uid}/items/settings   task types, importance levels, defaults (private)
//   users/{uid}/items/map        the mind map: nodes + edges (private)
//   users/{uid}/items/board      saved charts and the dashboards that lay them out (private)
//   people/{email}               { uid, name }, so tasks can be assigned by email
//   notify/{uid}                 push notification choices, time zone (private)
//   notify/{uid}/devices/{id}    one push token per browser or phone (private)
//
// Formwright data (see the Formwright README for the permission model):
//   forms/{formId}               form designs. Members of any group read; admins write.
//   records/{id}                 form entries, checked against users/{uid}.access
//   groups/{id}                  security groups (admins only)
//   users/{uid}                  Formwright account: role, groups, effective access.
//                                (Cadence's private items sit under it, in
//                                users/{uid}/items, with their own rules below.)
//   profiles/{uid}               display names for "Created by", and each person's own sign-in email (for assigning tasks)
//   reports/{id}                 saved reports: owner writes; shared ones readable by members
//   listViews/{id}               saved list views: yours are private; admins share them
//   reportDefs/{id}              saved reports (one chart, table, pivot or KPI each)
//   dashboards/{id}              dashboards: saved reports and text blocks laid out together
//   imports/{id}                 spreadsheet imports (admins only), kept so one can be undone
//   imports/{id}/before/{recId}  a record as it was before an import changed it
//
// Record links (v22): a task can point at one Formwright record through
//   recordId, formId and recordSnap (the record's title, the form's name and color,
//   copied so the assignee sees them even without access to the form).
//
// Privacy policy these rules enforce:
//   - Cadence is by approval: only admins and accounts an admin has approved
//     (users/{uid}.cadence) can use tasks, the directory, push settings and private items.
//   - Settings, the map and the board are private: only their owner can read or
//     write them. Nobody else can see them, not even people you share tasks with.
//   - A task is visible only to its owner and its assignee.
//   - The owner can change anything except who owns it, and can delete it.
//     The owner's email on a task must be the owner's real sign-in email.
//   - A task can only be assigned to the account that claimed that email in the
//     people directory, so nobody can drop tasks into a stranger's list by
//     guessing their account ID or spoofing their email.
//   - The assignee can complete it, change its date and time (which updates its
//     reschedule count), edit the
//     checklist and notes, or hand it back to the owner. Nothing else. They
//     can't change the title, type, importance, repeat or the linked map node.
//   - The people directory can be looked up one exact email at a time but
//     never listed, and only a verified email can claim its own entry.
//   - Notification settings and push tokens are private to their owner. Only
//     the Cloud Functions (which use admin access) read them to send pushes.
//   - "Finished by" on a task can only ever be set to the person writing it.
//   - Only a task's owner can set or change its record link, and only to a record
//     they can see in Formwright. The assignee can't change it. A repeating task's
//     next occurrence keeps the link it had, even if the record is gone by then.
//   - Everything else is denied. Writes are shape- and size-checked.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function optString(d, key, max) {
      return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= max);
    }

    function isDateKey(v) {
      return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function isTimeKey(v) {
      return v == null || (v is string && v.matches('^[0-9]{2}:[0-9]{2}$'));
    }

    function okSnap(d, key) {
      return !(key in d) || d[key] == null
          || (d[key] is map && d[key].keys().hasOnly(['name', 'color', 'glyph']));
    }

    // the signed-in person's email, lowercased, or null if the account has none
    function myEmail() {
      return request.auth.token.get('email', null) is string
        ? request.auth.token.email.lower()
        : null;
    }

    // ownerEmail is either blank or the writer's own sign-in email
    function ownerEmailIsMine(d) {
      return d.get('ownerEmail', null) == null || d.ownerEmail == myEmail();
    }

    // the assignee is whoever claimed assigneeEmail in the people directory
    function assigneeIsReal(d) {
      return d.get('assigneeId', null) == null
          || (d.get('assigneeEmail', null) is string
              && exists(/databases/$(database)/documents/people/$(d.assigneeEmail))
              && get(/databases/$(database)/documents/people/$(d.assigneeEmail)).data.uid == d.assigneeId);
    }

    // ─── Formwright access helpers (also used by record links) ───────────────
    // users/{uid}.access holds the effective level per form, computed from groups.

    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasAccount() { return signedIn() && exists(userPath()); }
    function me() { return get(userPath()).data; }
    function isAdmin() { return hasAccount() && me().get('role', 'member') == 'admin'; }
    // Someone an admin has let in: an admin, or in at least one security group. A brand-new
    // account sees nothing in Formwright (not even form designs or names) until then.
    // Cadence is by approval: an admin turns on "Cadence" for an account in Formwright's
    // Users screen (users/{uid}.cadence). Admins can always use it. Without approval an
    // account can't read or write tasks, the people directory, push settings or private items.
    function cadenceOk() { return hasAccount() && (me().get('role', 'member') == 'admin' || me().get('cadence', false) == true); }
    function isMember() { return hasAccount() && (me().get('role', 'member') == 'admin' || me().get('groups', []).size() > 0); }

    // Effective level for one form: the form's own entry, else the "*" default, else nothing.
    function level(formId) {
      let acc = me().get('access', {});
      return acc.get(formId, acc.get('*', {'view': 'none', 'edit': 'none'}));
    }
    function viewLevel(formId) { return level(formId).get('view', 'none'); }
    function editLevel(formId) { return level(formId).get('edit', 'none'); }

    function canViewRecord(d) {
      return isAdmin() || (hasAccount() && (
        viewLevel(d.formId) == 'all' ||
        (viewLevel(d.formId) == 'own' && d.ownerId == request.auth.uid)
      ));
    }
    function canEditRecord(d) {
      return isAdmin() || (hasAccount() && (
        editLevel(d.formId) == 'all' ||
        (editLevel(d.formId) == 'own' && d.ownerId == request.auth.uid)
      ));
    }
    // Workflows: while a record is at a stage, only its assignee (or a member of its assigned
    // group, who can see the record) and administrators may change it.
    function inWorkflow(d) { return d.get('stage', null) != null; }
    function PersonResponsible(d) {
      return hasAccount() && (d.get('assignee', null) == request.auth.uid
        || (d.get('assigneeGroup', null) != null && d.assigneeGroup in me().get('groups', []))
        || (d.get('assigneeRole', null) != null && d.assigneeRole in me().get('roles', [])));
    }
    function canEditNow(d) {
      return inWorkflow(d) ? (isAdmin() || PersonResponsible(d)) : canEditRecord(d);
    }
    function canCreateIn(formId) {
      return isAdmin() || (hasAccount() && editLevel(formId) in ['own', 'all']);
    }
    function validRecord(d) {
      return d.keys().hasOnly(['formId', 'values', 'parentId', 'parentFormId', 'ownerId',
                               'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'nums', 'autoLog', 'auto',
                               'stage', 'assignee', 'assigneeGroup', 'assigneeRole', 'stageAt'])
        && d.keys().hasAll(['formId', 'values', 'ownerId', 'createdBy', 'updatedBy'])
        && d.formId is string
        && d.values is map
        && d.ownerId is string
        && d.updatedBy == request.auth.uid
        // existsAfter so a batch can create a form and its first records together.
        && existsAfter(/databases/$(database)/documents/forms/$(d.formId));
    }

    // A record link is all three fields or none of them.
    function validRecordLink(d) {
      return (d.get('recordId', null) == null
                ? (d.get('formId', null) == null && d.get('recordSnap', null) == null)
                : (d.recordId is string && d.recordId.size() > 0 && d.recordId.size() <= 100
                   && d.get('formId', null) is string && d.formId.size() > 0 && d.formId.size() <= 100))
          && (d.get('recordSnap', null) == null
              || (d.recordSnap is map
                  && d.recordSnap.keys().hasOnly(['title', 'form', 'color'])
                  && optString(d.recordSnap, 'title', 500)
                  && optString(d.recordSnap, 'form', 200)
                  && optString(d.recordSnap, 'color', 40)));
    }

    function recordPath(id) {
      return /databases/$(database)/documents/records/$(id);
    }

    // No link, or a link to a record of that form which the writer can see in Formwright.
    function canLinkRecord(d) {
      return d.get('recordId', null) == null
          || (exists(recordPath(d.recordId))
              && get(recordPath(d.recordId)).data.formId == d.formId
              && (canViewRecord(get(recordPath(d.recordId)).data)
                  // whoever is responsible for its current workflow step can open it, so can add tasks
                  || PersonResponsible(get(recordPath(d.recordId)).data)));
    }

    // New task (create rule). u: my account, read once.
    function taskCreateOk(d, taskId) {
      let u = exists(userPath()) ? get(userPath()).data : null;
      return u != null
        && (u.get('role', 'member') == 'admin' || u.get('cadence', false) == true)
        && validTask(d, taskId)
        && (
          // owner: their own email, and a real assignee if any
          (d.ownerId == request.auth.uid
             && ownerEmailIsMine(d)
             && assigneeIsReal(d)
             && roleOk(d)
             && (d.get('recordId', null) == null
                 || recordLinkOkFor(u, d, recordPath(d.recordId))
                 || linkCopiedFromSource(d)))
          // assignee: next occurrence of a repeating task they were given (or their role was)
          || spawnedByAssignee(d)
          || spawnedByRoleHolder(d, u)
        );
    }
    // The linked record exists, is in the task's form, and u can see it (or is responsible
    // for its current workflow step). Same test as canLinkRecord, reading the record once.
    function recordLinkOkFor(u, d, p) {
      let r = exists(p) ? get(p).data : null;
      return r != null && r.formId == d.formId && seesRecordAs(u, r);
    }
    function seesRecordAs(u, r) {
      let acc = u.get('access', {});
      let view = acc.get(r.formId, acc.get('*', {'view': 'none'})).get('view', 'none');
      return u.get('role', 'member') == 'admin'
        || view == 'all'
        || (view == 'own' && r.ownerId == request.auth.uid)
        || r.get('assignee', null) == request.auth.uid
        || (r.get('assigneeGroup', null) != null && r.assigneeGroup in u.get('groups', []))
        || (r.get('assigneeRole', null) != null && r.assigneeRole in u.get('roles', []));
    }

    function taskPath(id) {
      return /databases/$(database)/documents/tasks/$(id);
    }

    // The next occurrence of a repeating task keeps its source's link unchanged.
    function linkCopiedFromSource(d) {
      return d.get('spawnedFrom', null) is string
          && exists(taskPath(d.spawnedFrom))
          && get(taskPath(d.spawnedFrom)).data.ownerId == d.ownerId
          && get(taskPath(d.spawnedFrom)).data.get('recordId', null) == d.get('recordId', null)
          && get(taskPath(d.spawnedFrom)).data.get('formId', null) == d.get('formId', null);
    }

    function validTask(d, taskId) {
      return d.keys().hasOnly([
               'id', 'title', 'notes', 'typeId', 'levelId', 'due', 'time',
               'done', 'doneAt', 'createdAt', 'updatedAt', 'subtasks',
               'repeat', 'sample', 'spawnedNext', 'spawnedFrom',
               'ownerId', 'ownerName', 'ownerEmail',
               'assigneeId', 'assigneeName', 'assigneeEmail', 'members',
               'typeSnap', 'levelSnap', 'nodeId', 'moved', 'pushed', 'doneBy', 'reassignedBy', 'reassignedAt',
               'recordId', 'formId', 'recordSnap',
               'assigneeRole', 'assigneeRoleName', 'doneByName', 'snooze'
             ])
          && d.keys().hasAll(['id', 'title', 'done', 'ownerId', 'members'])
          && d.id == taskId
          && d.title is string && d.title.size() > 0 && d.title.size() <= 500
          && d.done is bool
          && optString(d, 'notes', 20000)
          && optString(d, 'typeId', 100)
          && optString(d, 'levelId', 100)
          && optString(d, 'spawnedNext', 100)
          && optString(d, 'spawnedFrom', 100)
          && optString(d, 'nodeId', 100)
          && validRecordLink(d)
          && optString(d, 'ownerName', 200)
          && optString(d, 'ownerEmail', 320)
          && optString(d, 'assigneeName', 200)
          && optString(d, 'assigneeEmail', 320)
          && optString(d, 'assigneeRole', 100)
          && optString(d, 'assigneeRoleName', 80)
          && optString(d, 'doneByName', 200)
          // snooze: { uid: 'YYYY-MM-DD' }, each person's own day the task comes back on their list
          && (!('snooze' in d) || (d.snooze is map && d.snooze.size() <= 20))
          && okSnap(d, 'typeSnap')
          && okSnap(d, 'levelSnap')
          && isDateKey(d.get('due', null))
          && isTimeKey(d.get('time', null))
          && (!('repeat' in d) || d.repeat in ['none', 'daily', 'weekdays', 'weekly', 'monthly'])
          && (!('subtasks' in d) || (d.subtasks is list && d.subtasks.size() <= 200))
          && (!('sample' in d) || d.sample is bool)
          && (!('createdAt' in d) || d.createdAt is number)
          && (!('updatedAt' in d) || d.updatedAt is number)
          && (!('doneAt' in d) || d.doneAt == null || d.doneAt is number)
          // reschedule counts: how many times the due date moved, and days moved later
          && (!('moved' in d) || (d.moved is int && d.moved >= 0 && d.moved <= 100000))
          && (!('pushed' in d) || (d.pushed is int && d.pushed >= 0 && d.pushed <= 10000000))
          // who completed it: yourself, or left as it was
          && (d.get('doneBy', null) == null || d.doneBy == request.auth.uid
              || (resource != null && resource.data.get('doneBy', null) == d.doneBy))
          // who last passed it on (Formwright's Reassign): yourself, or left as it was
          && (d.get('reassignedBy', null) == null || d.reassignedBy == request.auth.uid
              || (resource != null && resource.data.get('reassignedBy', null) == d.reassignedBy))
          && (!('reassignedAt' in d) || d.reassignedAt == null || d.reassignedAt is number)
          // membership always mirrors owner + assignee. A task given to a role (Formwright → Roles)
          // has no assignee and only its owner as a member: the role's holders read it by role.
          && d.ownerId is string
          && d.members is list && d.members.size() >= 1 && d.members[0] == d.ownerId
          && (d.get('assigneeRole', null) == null || (d.get('assigneeId', null) == null && d.members.size() == 1))
          && (d.get('assigneeId', null) == null
                ? d.members.size() == 1
                : (d.assigneeId is string && d.assigneeId != d.ownerId
                   && d.members.size() == 2 && d.members[1] == d.assigneeId));
    }

    function validSettings(d) {
      return d.keys().hasOnly(['kind', 'types', 'levels', 'defaultLevel', 'defaultType'])
          && d.kind == 'settings'
          && d.types is list && d.types.size() <= 50
          && d.levels is list && d.levels.size() >= 1 && d.levels.size() <= 20
          && optString(d, 'defaultLevel', 100)
          && optString(d, 'defaultType', 100);
    }

    // The whole map is one document (Firestore caps a document at 1 MiB).
    function validMap(d) {
      return d.keys().hasOnly(['kind', 'nodes', 'edges', 'updatedAt'])
          && d.kind == 'map'
          && d.nodes is list && d.nodes.size() <= 5000
          && d.edges is list && d.edges.size() <= 10000
          && (!('updatedAt' in d) || d.updatedAt is number);
    }

    // Saved charts and the dashboards that lay them out: settings only, no task data.
    // dashboards: [{ id, name, tiles: [{ id, chart | text, x, y, w, h }] }]; home: a dashboard id.
    function validBoard(d) {
      return d.keys().hasOnly(['kind', 'charts', 'updatedAt', 'dashboards', 'home'])
          && d.kind == 'board'
          && d.charts is list && d.charts.size() <= 200
          && (!('dashboards' in d) || (d.dashboards is list && d.dashboards.size() <= 100))
          && (!('home' in d) || (d.home is string && d.home.size() <= 100))
          && (!('updatedAt' in d) || d.updatedAt is number);
    }

    function isAssignee() {
      return resource.data.get('assigneeId', null) == request.auth.uid;
    }
    // Roles: the task is given to a role this person holds (users/{uid}.roles, set by administrators)
    function isRoleHolder() {
      return resource.data.get('assigneeRole', null) != null && hasAccount()
          && resource.data.assigneeRole in me().get('roles', []);
    }
    // a task given to a role names one that exists
    function roleOk(d) {
      return d.get('assigneeRole', null) == null
          || exists(/databases/$(database)/documents/roles/$(d.assigneeRole));
    }
    // The next occurrence of a repeating task given to a role, made by one of its holders on completion.
    function spawnedByRoleHolder(d, u) {
      return d.get('assigneeRole', null) != null
          && d.assigneeRole in u.get('roles', [])
          && d.get('spawnedFrom', null) is string
          && exists(taskPath(d.spawnedFrom))
          && get(taskPath(d.spawnedFrom)).data.ownerId == d.ownerId
          && get(taskPath(d.spawnedFrom)).data.get('assigneeRole', null) == d.assigneeRole
          && linkCopiedFromSource(d);
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The next occurrence of a repeating task, created by its assignee on completion.
    // It must point at a task this person is assigned, and keep that task's owner.
    function spawnedByAssignee(d) {
      return d.get('assigneeId', null) == request.auth.uid
          && d.get('spawnedFrom', null) is string
          && exists(/databases/$(database)/documents/tasks/$(d.spawnedFrom))
          && get(/databases/$(database)/documents/tasks/$(d.spawnedFrom)).data.ownerId == d.ownerId
          && get(/databases/$(database)/documents/tasks/$(d.spawnedFrom)).data.get('assigneeId', null) == request.auth.uid
          && linkCopiedFromSource(d);
    }

    match /tasks/{taskId} {
      // reads (single gets and the app's "members array-contains me" query). Administrators also
      // read tasks linked to Formwright records (Formwright → My work → All tasks); people's
      // own tasks without a record link stay private.
      allow read: if signedIn() && ((request.auth.uid in resource.data.members && cadenceOk())
                                    || (isRoleHolder() && cadenceOk())
                                    || (isAdmin() && resource.data.get('recordId', null) != null));

      // Reads each document once (account, record, assignee's people entry): Firestore allows
      // at most 10 document reads per request, and a linked task given to someone needs all three.
      allow create: if signedIn() && taskCreateOk(request.resource.data, taskId);

      allow update: if signedIn() && cadenceOk()
        && validTask(request.resource.data, taskId)
        && (
          // owner: anything except ownership. A changed email must be their own,
          // and a new assignee must be the person who owns that email.
          (resource.data.ownerId == request.auth.uid
             && request.resource.data.ownerId == resource.data.ownerId
             && (!changed().hasAny(['ownerEmail']) || ownerEmailIsMine(request.resource.data))
             && (!changed().hasAny(['assigneeId']) || assigneeIsReal(request.resource.data))
             && (!changed().hasAny(['recordId', 'formId']) || canLinkRecord(request.resource.data))
             && (!changed().hasAny(['assigneeRole']) || roleOk(request.resource.data)))
          // assignee, or anyone holding the role it's given to: do the work and move the date
          // (never the record link). The first to tick it off is credited (doneBy, doneByName).
          || ((isAssignee() || isRoleHolder())
             && changed().hasOnly(['done', 'doneAt', 'due', 'time', 'subtasks',
                                   'notes', 'updatedAt', 'spawnedNext', 'moved', 'pushed', 'doneBy', 'doneByName', 'snooze']))
          // assignee: hand it back to the owner
          || (isAssignee()
             && request.resource.data.get('assigneeId', null) == null
             && changed().hasOnly(['assigneeId', 'assigneeName', 'assigneeEmail',
                                   'members', 'updatedAt']))
          // Reassign (Formwright): on a task linked to a record, the person it's assigned to, or
          // an administrator, gives it to someone else (or back to the owner). Only who it's
          // with changes; the owner stays.
          || ((isAssignee() || isRoleHolder() || isAdmin())
             && resource.data.get('recordId', null) != null
             && request.resource.data.ownerId == resource.data.ownerId
             && request.resource.data.get('reassignedBy', null) == request.auth.uid
             && changed().hasOnly(['assigneeId', 'assigneeName', 'assigneeEmail', 'assigneeRole', 'assigneeRoleName',
                                   'members', 'updatedAt', 'reassignedBy', 'reassignedAt'])
             && assigneeIsReal(request.resource.data)
             && roleOk(request.resource.data))
        );

      allow delete: if signedIn() && cadenceOk()
        // deleting a task that never reached the server is a no-op
        && (resource == null
            || resource.data.ownerId == request.auth.uid
            // undoing a completion removes the occurrence it spawned
            || ((isAssignee() || isRoleHolder())
                && resource.data.get('spawnedFrom', null) != null
                && resource.data.done == false));
    }

    match /people/{email} {
      // one exact address at a time; the directory can't be listed or scraped
      allow get: if signedIn() && cadenceOk();
      allow list: if false;
      allow create, update: if signedIn() && cadenceOk()
        && request.auth.token.email_verified == true
        && myEmail() != null
        && email == myEmail()
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && optString(request.resource.data, 'name', 200);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Push notifications: what to be told about, and each device's push token.
    function validNotify(d) {
      return d.keys().hasOnly(['kind', 'due', 'assigned', 'finished', 'digest', 'morning', 'lead',
                               'tz', 'origin', 'updatedAt', 'testAt'])
          && d.kind == 'notify'
          && (!('due' in d) || d.due is bool)
          && (!('assigned' in d) || d.assigned is bool)
          && (!('finished' in d) || d.finished is bool)
          && (!('digest' in d) || d.digest is bool)
          && (!('morning' in d) || isTimeKey(d.morning))
          && (!('lead' in d) || (d.lead is int && d.lead >= 0 && d.lead <= 1440))
          && optString(d, 'tz', 64)
          && (!('origin' in d) || (d.origin is string && d.origin.size() <= 300 && d.origin.matches('^https?://.*')))
          && (!('updatedAt' in d) || d.updatedAt is number)
          && (!('testAt' in d) || d.testAt is number);
    }
    match /notify/{uid} {
      allow read: if isOwner(uid) && cadenceOk();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && cadenceOk() && validNotify(request.resource.data);
      match /devices/{deviceId} {
        allow read: if isOwner(uid) && cadenceOk();
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && cadenceOk()
          && request.resource.data.keys().hasOnly(['token', 'label', 'createdAt', 'updatedAt'])
          && request.resource.data.token is string && request.resource.data.token.size() <= 4096
          && optString(request.resource.data, 'label', 120);
      }
    }

    // Private settings, map and board: only the owner, never anyone else.
    // Tasks stored here by app version 7 and earlier can be read and deleted
    // (the app moves them to /tasks) but no longer written, so an outdated tab
    // can't re-upload stale copies.
    match /users/{uid}/items/{itemId} {
      allow read: if isOwner(uid) && cadenceOk();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && cadenceOk()
        && ((itemId == 'settings' && validSettings(request.resource.data))
            || (itemId == 'map' && validMap(request.resource.data))
            || (itemId == 'board' && validBoard(request.resource.data)));
    }

    // ─── Formwright ──────────────────────────────────────────────────────────
    // Forms, records, security groups and accounts. A member's access to each form
    // is the map on users/{uid}.access, which an admin's browser computes from the
    // member's groups. Levels: "none", "own" (records they created) or "all".

    match /forms/{formId} {
      allow read: if isMember();
      allow write: if isAdmin();

      // Version history: a copy of the form each time it's saved (or saved as a draft).
      // Admins only; written as themselves; never changed or deleted.
      match /versions/{versionId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.kind in ['saved', 'draft', 'loaded', 'activated', 'baseline']
          && request.resource.data.n is int
          && request.resource.data.at is int
          && request.resource.data.form is map;
      }
    }

    match /records/{recordId} {
      // List queries must filter by formId, and by ownerId == your uid when you only
      // have "own" access, or Firestore rejects the query.
      allow read: if signedIn() && (canViewRecord(resource.data) || PersonResponsible(resource.data));

      allow create: if signedIn()
        && validRecord(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        // auto numbers (nums) and their change log are written only by the server
        && !('nums' in request.resource.data)
        && !('autoLog' in request.resource.data)
        && !('auto' in request.resource.data)
        && canCreateIn(request.resource.data.formId);

      allow update: if signedIn()
        && validRecord(request.resource.data)
        && canEditNow(resource.data)
        && request.resource.data.formId == resource.data.formId
        // only administrators give a record to someone else, and only to a real account
        && (request.resource.data.ownerId == resource.data.ownerId
            || (isAdmin() && exists(/databases/$(database)/documents/users/$(request.resource.data.ownerId))))
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('nums', null) == resource.data.get('nums', null)
        && request.resource.data.get('autoLog', null) == resource.data.get('autoLog', null)
        // which automation last changed it (server only)
        && request.resource.data.get('auto', null) == resource.data.get('auto', null);

      allow delete: if signedIn() && canEditNow(resource.data);

      // Workflow stage history: written by whoever moves the record, as themselves; never changed.
      match /stages/{entryId} {
        allow read: if signedIn() && (canViewRecord(get(recordPath(recordId)).data) || PersonResponsible(get(recordPath(recordId)).data));
        allow create: if signedIn()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.keys().hasOnly(['at', 'by', 'from', 'fromName', 'to', 'toName', 'label', 'comment', 'assignee', 'assigneeGroup',
                                                    'assigneeRole', 'assigneeRoleName', 'asRole', 'asRoleName'])
          // "moved as" a role: only a role the mover holds
          && (request.resource.data.get('asRole', null) == null || request.resource.data.asRole in me().get('roles', []))
          && (isAdmin() || PersonResponsible(get(recordPath(recordId)).data) || canEditNow(get(recordPath(recordId)).data));
        allow delete: if isAdmin();
      }

      // Email PDF: what was sent, written only by the server; readable with the record
      match /emails/{emailId} {
        allow read: if signedIn() && canViewRecord(get(/databases/$(database)/documents/records/$(recordId)).data);
        allow write: if false;
      }

      // Comments: anyone who can see the record can read and add them (view-only too).
      // You can change or remove your own; admins can remove any. Replies are one level deep.
      // The server writes "notified" (who it told about an @mention) and removes the replies
      // of a removed comment.
      match /comments/{commentId} {
        allow read: if signedIn() && seesRecord(recordId);
        allow create: if signedIn() && seesRecord(recordId)
          && validComment(request.resource.data)
          && request.resource.data.by == request.auth.uid
          && !('notified' in request.resource.data)
          && !('editedAt' in request.resource.data)
          && (request.resource.data.parent == null
              || get(/databases/$(database)/documents/records/$(recordId)/comments/$(request.resource.data.parent)).data.parent == null);
        allow update: if signedIn() && seesRecord(recordId)
          && resource.data.by == request.auth.uid
          && validComment(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentions', 'editedAt']);
        allow delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
      }
    }

    function seesRecord(recordId) {
      let r = get(recordPath(recordId)).data;
      return canViewRecord(r) || PersonResponsible(r);
    }
    function validComment(d) {
      return d.keys().hasOnly(['by', 'byName', 'at', 'text', 'mentions', 'parent', 'task', 'editedAt', 'notified'])
        && d.keys().hasAll(['by', 'at', 'text', 'mentions', 'parent'])
        && d.text is string && d.text.size() > 0 && d.text.size() <= 5000
        && d.mentions is list && d.mentions.size() <= 20
        && (d.parent == null || (d.parent is string && d.parent.size() <= 100))
        && d.at is number
        && optString(d, 'byName', 120)
        && (!('task' in d) || d.task is bool)
        && (!('editedAt' in d) || d.editedAt is number);
    }

    // Word templates (Formwright → a record → Export ▾): anyone who can see the form can add one
    // and use it; whoever added it, or an administrator, can rename, replace or delete it.
    // The .docx is in Storage at docTemplates/{formId}/{uid}/… (storage.rules).
    function seesForm(formId) { return isAdmin() || (hasAccount() && viewLevel(formId) != 'none'); }
    function validTemplate(d) {
      return d.keys().hasOnly(['formId', 'name', 'path', 'url', 'size', 'by', 'byName', 'at', 'updatedAt', 'tags', 'problems'])
        && d.keys().hasAll(['formId', 'name', 'path', 'by'])
        && d.formId is string && d.formId.size() > 0 && d.formId.size() <= 100
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.path is string && d.path.matches('docTemplates/' + d.formId + '/' + d.by + '/[^/]{1,200}')
        && optString(d, 'url', 2000) && optString(d, 'byName', 120)
        && (!('size' in d) || d.size is number);
    }
    match /docTemplates/{templateId} {
      allow read: if signedIn() && seesForm(resource.data.formId);
      allow create: if signedIn() && validTemplate(request.resource.data)
        && request.resource.data.by == request.auth.uid
        && seesForm(request.resource.data.formId);
      allow update: if signedIn() && validTemplate(request.resource.data)
        && (resource.data.by == request.auth.uid || isAdmin())
        && request.resource.data.formId == resource.data.formId
        && request.resource.data.by == resource.data.by;
      allow delete: if signedIn() && (resource.data.by == request.auth.uid || isAdmin());
    }

    // @mentions (Formwright → My work → Mentions): written only by the server when someone
    // mentions you in a comment. Only you can read them, mark them read or clear them.
    match /mentions/{mentionId} {
      // administrators see everyone's (My work → All mentions); only you mark yours read or clear them
      allow read: if signedIn() && (resource.data.to == request.auth.uid || isAdmin());
      allow delete: if signedIn() && resource.data.to == request.auth.uid;
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create: if false;
    }

    // Automations (Formwright → Administration → Automations): admins set them up; the server
    // runs them (functions/automate.js) and writes their run log.
    function validAutomation(d) {
      return d.keys().hasOnly(['name', 'formId', 'on', 'trigger', 'join', 'conds', 'acts', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['name', 'formId', 'on', 'trigger', 'acts', 'createdBy'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.formId is string && d.formId.size() > 0 && d.formId.size() <= 100
        && d.on is bool
        && d.trigger is map && d.trigger.get('type', '') in ['created', 'changed', 'date', 'emailed', 'stage', 'schedule']
        && d.acts is list && d.acts.size() <= 10
        && (!('conds' in d) || (d.conds is list && d.conds.size() <= 12))
        && d.createdBy is string;
    }
    match /automations/{autoId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validAutomation(request.resource.data) && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() && validAutomation(request.resource.data) && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
      match /runs/{runId} {
        allow read, delete: if isAdmin();
        allow create, update: if false;
      }
      match /fired/{recordId} {
        allow read, write: if false;
      }
      // scheduled automations: this month's run and heads-up, claimed by the server
      match /sched/{what} {
        allow read, write: if false;
      }
    }

    // Scheduled automations with "approve first": each record waiting for an administrator's
    // OK. The server writes them; Send now / Don't send go through the automationSend function.
    match /pendingSends/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Dashboards emailed on a schedule (Formwright → a dashboard → Email schedule): administrators
    // set them; the server sends them and notes when (lastSlot, lastAt, lastStatus, lastTo).
    match /dashMails/{dashboardId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['dashboardId', 'on', 'freq', 'day', 'hour', 'to', 'createdAt', 'updatedAt', 'updatedBy', 'lastSlot', 'lastAt', 'lastStatus', 'lastTo'])
        && request.resource.data.dashboardId == dashboardId
        && request.resource.data.on is bool
        && request.resource.data.freq in ['weekdays', 'weekly', 'monthly', 'daily']
        && request.resource.data.hour is int && request.resource.data.hour >= 0 && request.resource.data.hour <= 23
        && request.resource.data.day is int && request.resource.data.day >= 0 && request.resource.data.day <= 28
        && request.resource.data.to is map
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Workflows: which overdue emails went out for a record's current stage (server only)
    match /stageOverdue/{recordId} {
      allow read, write: if false;
    }

    // Problems (Formwright → Settings → Problems): what went wrong for people, for administrators.
    // Anyone signed in can report their own (size-limited, never changed); the server reports its
    // own and clears old ones. Only administrators read or clear them.
    function validProblem(d) {
      return d.keys().hasOnly(['at', 'app', 'uid', 'name', 'where', 'message', 'code', 'detail', 'url', 'agent', 'version'])
        && d.keys().hasAll(['at', 'app', 'uid', 'message'])
        && d.uid == request.auth.uid
        && d.app in ['formwright', 'cadence']
        && d.at is int
        && d.message is string && d.message.size() > 0 && d.message.size() <= 500
        && optString(d, 'name', 100) && optString(d, 'where', 200) && optString(d, 'code', 100)
        && optString(d, 'detail', 4000) && optString(d, 'url', 300) && optString(d, 'agent', 300) && optString(d, 'version', 40);
    }
    match /problems/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn() && validProblem(request.resource.data);
      allow update: if false;
    }

    // What the server's own jobs last did (system/backup: the nightly backup): admins read it.
    match /system/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Audit trail (Formwright → Administration): written only by the server; admins read it.
    match /audit/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Auto number counters (Formwright): handed out by the server only; admins may look.
    match /counters/{counterId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /groups/{groupId} {
      allow read, write: if isAdmin();
    }

    // Roles (Formwright → Administration → Roles): who does the work (a workflow stage can go to a
    // role). Separate from security groups, which decide access. Everyone with an account reads the
    // names; administrators manage them and who holds them (users/{uid}.roles).
    match /roles/{roleId} {
      allow read: if hasAccount();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'description', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && optString(request.resource.data, 'description', 500);
      allow delete: if isAdmin();
    }

    // Starred records (Formwright): each person's own, private (nobody else reads them)
    match /stars/{userId} {
      allow read, delete: if signedIn() && userId == request.auth.uid;
      allow create, update: if signedIn() && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ids', 'updatedAt'])
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 100
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is int);
    }

    match /profiles/{userId} {
      // Formwright members, and Cadence users (its "Assigned to" lists everyone), read the names
      allow read: if isMember() || cadenceOk() || (signedIn() && userId == request.auth.uid);
      allow create, update: if signedIn() && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'homeDashboard', 'email'])
        // email: your own sign-in address, so others can give you Cadence tasks from Formwright
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.get('email', ''))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && optString(request.resource.data, 'homeDashboard', 100)
        // photoURL: their Google account photo (https only)
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 1000 && request.resource.data.photoURL.matches('https://[^ ]+')));
      allow delete: if isAdmin() || (signedIn() && userId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if signedIn() && (userId == request.auth.uid || isAdmin());

      // A new account starts as a member with no groups and no access.
      allow create: if signedIn() && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'groups', 'access', 'createdAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.groups == []
        && request.resource.data.access == {}
        && request.resource.data.email == request.auth.token.get('email', '');

      // Users may change only their display name. Admins may change anything.
      allow update: if isAdmin()
        || (signedIn() && userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));

      allow delete: if isAdmin();
    }

    // Reports (Formwright's report builder): saved by their owner. A shared report can be
    // read by anyone with a Formwright account; its numbers are always worked out in the
    // reader's own browser from the records the reader is allowed to see.
    function validReport(d) {
      return d.keys().hasOnly(['name', 'ownerId', 'shared', 'widgets', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'ownerId', 'shared', 'widgets'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.ownerId is string
        && d.shared is bool
        && d.widgets is list && d.widgets.size() <= 60
        && (!('createdAt' in d) || d.createdAt is number)
        && (!('updatedAt' in d) || d.updatedAt is number);
    }

    match /reports/{reportId} {
      allow read: if hasAccount()
        && (resource.data.ownerId == request.auth.uid || (resource.data.shared == true && isMember()) || isAdmin());
      allow create: if hasAccount()
        && validReport(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if hasAccount()
        && resource.data.ownerId == request.auth.uid
        && validReport(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if hasAccount() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Saved list views (Formwright's records lists): which columns, sort, filters and row
    // height a form's list shows. Your own views are private; shared views are made by
    // admins and seen by everyone with an account. The view with ID "dflt-<formId>" is a
    // form's default list, and only an admin can make it. A view never grants access to
    // records: each list still shows only the records the reader may see.
    function validListView(d) {
      return d.keys().hasOnly(['formId', 'name', 'ownerId', 'shared', 'cols', 'sort', 'filters', 'density', 'layout', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['formId', 'name', 'ownerId', 'shared', 'cols', 'sort'])
        && d.formId is string && d.formId.size() > 0 && d.formId.size() <= 100
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.ownerId is string
        && d.shared is bool
        && d.cols is list && d.cols.size() <= 30
        && d.sort is map && d.sort.keys().hasOnly(['key', 'dir'])
        && (!('filters' in d) || (d.filters is map && d.filters.size() <= 40))
        && (!('density' in d) || d.density in ['cozy', 'compact'])
        // Board or Timeline (Formwright's layoutlogic.js): how the view shows its records
        && (!('layout' in d) || (d.layout is map
            && d.layout.keys().hasOnly(['kind', 'by', 'sum', 'start', 'end', 'color', 'zoom'])
            && d.layout.get('kind', 'table') in ['table', 'board', 'timeline']
            && d.layout.get('zoom', 'month') in ['week', 'month', 'quarter']
            && optString(d.layout, 'by', 100) && optString(d.layout, 'sum', 100) && optString(d.layout, 'start', 100)
            && optString(d.layout, 'end', 100) && optString(d.layout, 'color', 100)))
        && (!('createdAt' in d) || d.createdAt is number)
        && (!('updatedAt' in d) || d.updatedAt is number);
    }

    match /listViews/{viewId} {
      allow read: if hasAccount()
        && (resource.data.ownerId == request.auth.uid || (resource.data.shared == true && isMember()) || isAdmin());
      allow create: if hasAccount()
        && validListView(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && (request.resource.data.shared == false || isAdmin())
        && (!viewId.matches('^dflt-.*') || isAdmin());
      // Owners update their own private views; admins update shared ones (and may share or
      // unshare). The owner and form never change.
      allow update: if hasAccount()
        && validListView(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.formId == resource.data.formId
        && (isAdmin()
            || (resource.data.ownerId == request.auth.uid
                && resource.data.shared == false
                && request.resource.data.shared == false));
      allow delete: if hasAccount() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Saved reports and dashboards (Formwright). Yours are private until an admin shares
    // them. A shared one is readable by anyone with an account: "groups" only decides whose
    // lists it appears in. Neither holds record data: every number is worked out in the
    // reader's browser from the records the reader is allowed to see.
    function sharedOk(d) {
      return d.shared == false || isAdmin();
    }
    function audience(d) {
      return (!('groups' in d) || (d.groups is list && d.groups.size() <= 30));
    }
    function validReportDef(d) {
      return d.keys().hasOnly(['name', 'ownerId', 'shared', 'groups', 'def', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'ownerId', 'shared', 'def'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.ownerId is string && d.shared is bool && audience(d)
        && d.def is map && d.def.form is string
        && (!('createdAt' in d) || d.createdAt is number)
        && (!('updatedAt' in d) || d.updatedAt is number);
    }
    function validDashboard(d) {
      return d.keys().hasOnly(['name', 'ownerId', 'shared', 'groups', 'tiles', 'filters', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'ownerId', 'shared', 'tiles'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.ownerId is string && d.shared is bool && audience(d)
        && d.tiles is list && d.tiles.size() <= 60
        && (!('filters' in d) || d.filters is map)
        && (!('createdAt' in d) || d.createdAt is number)
        && (!('updatedAt' in d) || d.updatedAt is number);
    }

    match /reportDefs/{id} {
      allow read: if hasAccount()
        && (resource.data.ownerId == request.auth.uid || (resource.data.shared == true && isMember()) || isAdmin());
      allow create: if hasAccount() && validReportDef(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid && sharedOk(request.resource.data);
      // Owners edit their own (sharing needs an admin); admins also edit shared ones.
      allow update: if hasAccount() && validReportDef(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && ((resource.data.ownerId == request.auth.uid && sharedOk(request.resource.data))
            || (isAdmin() && resource.data.shared == true));
      allow delete: if hasAccount() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /dashboards/{id} {
      allow read: if hasAccount()
        && (resource.data.ownerId == request.auth.uid || (resource.data.shared == true && isMember()) || isAdmin());
      allow create: if hasAccount() && validDashboard(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid && sharedOk(request.resource.data);
      allow update: if hasAccount() && validDashboard(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && ((resource.data.ownerId == request.auth.uid && sharedOk(request.resource.data))
            || (isAdmin() && resource.data.shared == true));
      allow delete: if hasAccount() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Spreadsheet imports (Formwright, admins only). Each import lists the records it added
    // and changed, so it can be undone for 7 days; the records it changed are kept as they
    // were in imports/{id}/before/{recordId}. The imported records themselves go through
    // the records rules above like any other save.
    function validImport(d) {
      return d.keys().hasOnly(['formId', 'formName', 'fileName', 'ownerId', 'createdAt', 'stamp', 'status',
                               'added', 'updated', 'counts', 'finishedAt', 'undoneAt', 'undoneBy', 'undo'])
        && d.keys().hasAll(['formId', 'ownerId', 'createdAt', 'status', 'added', 'updated'])
        && d.formId is string && d.formId.size() > 0 && d.formId.size() <= 100
        && d.ownerId is string
        && d.createdAt is number
        && d.status in ['running', 'done', 'failed', 'undone']
        && d.added is list && d.added.size() <= 5000
        && d.updated is list && d.updated.size() <= 5000
        && optString(d, 'fileName', 200)
        && optString(d, 'formName', 120)
        && (!('counts' in d) || d.counts is map)
        && (!('undo' in d) || d.undo is map);
    }

    match /imports/{importId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validImport(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid;
      // Finishing or undoing an import. What it imported, who ran it and when never change.
      allow update: if isAdmin()
        && validImport(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.formId == resource.data.formId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.added == resource.data.added
        && request.resource.data.updated == resource.data.updated;
      allow delete: if isAdmin();

      match /before/{recordId} {
        allow read, delete: if isAdmin();
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['values', 'parentId', 'parentFormId', 'updatedAt', 'updatedBy'])
          && request.resource.data.values is map;
      }
    }

    // ─── PDF exports: company name and logo (Formwright → Administration → PDF exports) ──
    // One document, settings/exports. Everyone let in reads it (their exports print it);
    // only administrators change it. The logo is a small PNG or JPEG data URL.
    function validExportSettings(d) {
      return d.keys().hasOnly(['companyName', 'logo', 'updatedAt', 'updatedBy'])
        && optString(d, 'companyName', 120)
        && (d.get('logo', null) == null
            || (d.logo is string && d.logo.size() <= 600000
                && d.logo.split(',')[0] in ['data:image/png;base64', 'data:image/jpeg;base64']))
        && d.updatedAt is int
        && d.updatedBy == request.auth.uid;
    }

    match /settings/{id} {
      allow read: if isMember();
      allow create, update: if isAdmin() && (
        (id == 'exports' && validExportSettings(request.resource.data))
        // settings/home: the dashboard Home shows for anyone who hasn't chosen their own
        // settings/calendar: time zone, week start, fiscal year (Formwright → Settings → Dates and time)
        || (id == 'calendar' && request.resource.data.keys().hasOnly(['timeZone', 'weekStart', 'fyStart', 'updatedAt', 'updatedBy'])
            && request.resource.data.timeZone is string && request.resource.data.timeZone.size() > 0 && request.resource.data.timeZone.size() <= 60
            && request.resource.data.weekStart in [0, 1]
            && request.resource.data.fyStart is int && request.resource.data.fyStart >= 1 && request.resource.data.fyStart <= 12
            && request.resource.data.updatedAt is int && request.resource.data.updatedBy == request.auth.uid)
        // settings/problems: administrators who get the morning email of new problems
        || (id == 'problems' && request.resource.data.keys().hasOnly(['notify', 'updatedAt', 'updatedBy'])
            && request.resource.data.notify is list && request.resource.data.notify.size() <= 20
            && request.resource.data.updatedAt is int && request.resource.data.updatedBy == request.auth.uid)
        || (id == 'home' && request.resource.data.keys().hasOnly(['dashboardId', 'updatedAt', 'updatedBy'])
            && request.resource.data.dashboardId is string && request.resource.data.dashboardId.size() <= 100
            && request.resource.data.updatedBy == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Default deny for every other path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
