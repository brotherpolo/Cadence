{
  "name": "cadence-rules-tests",
  "private": true,
  "type": "module",
  "description": "Security rules tests for Cadence and Formwright. Development only: the app itself has no build step.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project demo-cadence \"node --test --test-concurrency=1 rules/*.test.js\"",
    "test:unit": "node --test unit/*.test.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.2",
    "firebase-tools": "^13.24.2"
  },
  "engines": {
    "node": ">=22"
  }
}
