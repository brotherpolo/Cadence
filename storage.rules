rules_version = '2';

// Formwright file uploads, at uploads/{formId}/{uploaderUid}/{fileName}.
// Deployed from the Cadence folder with the Firestore rules (both apps share tasks-2ae9d).
// Permissions mirror the Firestore `access` map on users/{uid} (cross-service rules).
// The first deploy asks you to let Storage read Firestore; accept it.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function me() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return me().get('role', 'member') == 'admin'; }
    function level(formId) {
      let acc = me().get('access', {});
      return acc.get(formId, acc.get('*', {'view': 'none', 'edit': 'none'}));
    }
    function canViewRecord(d) {
      return level(d.formId).get('view', 'none') == 'all'
        || (level(d.formId).get('view', 'none') == 'own' && d.get('ownerId', '') == request.auth.uid)
        || d.get('assignee', '') == request.auth.uid; // the person a workflow record is waiting on
    }

    match /uploads/{formId}/{ownerId}/{fileName} {
      allow read: if signedIn() && (
        isAdmin()
        || level(formId).get('view', 'none') == 'all'
        || (level(formId).get('view', 'none') == 'own' && ownerId == request.auth.uid)
      );

      allow create: if signedIn()
        && ownerId == request.auth.uid
        && (isAdmin() || level(formId).get('edit', 'none') in ['own', 'all'])
        && request.resource.size < 25 * 1024 * 1024
        // no web pages or scripts: they could run in a browser that opens the file's link
        && (request.resource.contentType == null
            || !request.resource.contentType.lower().matches('(text/html|application/xhtml\\+xml|image/svg\\+xml|text/javascript|application/(x-)?javascript|application/ecmascript|text/xml|application/xml).*'));

      allow delete: if signedIn() && (ownerId == request.auth.uid || isAdmin());
    }

    // Word templates (Formwright → Export ▾): anyone who can see the form reads and adds them;
    // the person who added one, or an administrator, deletes it.
    match /docTemplates/{formId}/{ownerId}/{fileName} {
      allow read: if signedIn() && (isAdmin() || level(formId).get('view', 'none') != 'none');
      allow create: if signedIn()
        && ownerId == request.auth.uid
        && (isAdmin() || level(formId).get('view', 'none') != 'none')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
      allow delete: if signedIn() && (ownerId == request.auth.uid || isAdmin());
    }

    // Email PDF: the PDF as it was sent, kept by the server (sentEmails/{recordId}/{emailId}.pdf).
    // Anyone who can see the record can open it, like the Sent emails list. Only the server
    // writes or deletes these (Delete and Delete all go through deleteSentEmails).
    match /sentEmails/{recordId}/{fileName} {
      allow read: if signedIn() && (isAdmin() || canViewRecord(firestore.get(/databases/(default)/documents/records/$(recordId)).data));
      allow write: if false;
    }
  }
}
